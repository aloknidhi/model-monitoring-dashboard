# Model Monitoring Dashboard — environment variables
# Copy to .env and edit before running docker-compose up

# Database
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=personal_ai_brain
DATABASE_URL=postgresql://ai_user:secure_password@db:5432/personal_ai_brain

# Monitoring backend
MONITORING_PORT=8001
DASHBOARD_PORT=8080
